{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Endpoints das integracoes de IA. Nao sao segredos: os tokens correspondentes
  // (GitHubModels:Token e Groq:Token) ficam em user-secrets no dev e em variaveis
  // de ambiente na nuvem. Ver a secao "Configuracao" do README.
  "GitHubModels": {
    "ApiUrl": "https://models.inference.ai.azure.com/chat/completions"
  },
  "Groq": {
    "ApiUrl": "https://api.groq.com/openai/v1/chat/completions"
  },

  // Origens liberadas no CORS. Em producao, sobrescrever com a URL do frontend
  // na Vercel usando Cors__Origens__0, Cors__Origens__1, ...
  "Cors": {
    "Origens": [ "http://localhost:5173" ]
  },

  // Contas com permissao de escrita no catalogo de exercicios (POST/PUT/DELETE).
  // Comparado com a claim de email do JWT, sem diferenciar maiusculas/minusculas.
  // Em producao, sobrescrever com Admin__Emails__0.
  "Admin": {
    "Emails": []
  }
}
